---
import { invitation as w, asset } from '../../data/invitation';
import { gardenScenes } from '../../data/gardenScenes';
---
<section class="chapter-journey" id="celebrations" aria-labelledby="chapters-title">
  <div class="chapters-intro">
    <p class="eyebrow">02 / Four celebrations. Four worlds.</p>
    <h2 id="chapters-title">Every moment,<br /><em>its own kind of magic.</em></h2>
    <p lang="hi" class="chapter-hindi-kicker">मांगलिक कार्यक्रम</p>
    <p class="chapters-instruction">Follow the light. The garden changes as you scroll.</p>
    <a href="#scene-tilakotsav" class="down-line" aria-label="Explore the four ceremonies"><span aria-hidden="true">↓</span></a>
  </div>
  <div class="chapter-layout" id="chapter-layout">
    <div class="chapter-art-column" aria-hidden="true">
      <div class="chapter-art">
        {gardenScenes.map((scene, index) => <div class:list={['scene-layer', { active: index === 0 }]} data-scene-art={index}>
          <img src={asset(`images/garden/${scene.image}.webp`)} alt="" width="1536" height="1024" loading="lazy" decoding="async" />
        </div>)}
        <div class="scene-shade"></div>
        <div class="scene-corner top-left"></div><div class="scene-corner bottom-right"></div>
        <div class="scene-overlay"><span class="scene-overline" id="scene-mood">{gardenScenes[0].mood}</span><p id="scene-poetry">{gardenScenes[0].title}</p><span class="scene-pagination"><b id="scene-number">01</b><i></i>04</span></div>
      </div>
    </div>
    <div class="chapter-pages">
      {w.events.map((event, index) => {
        const scene = gardenScenes[index];
        return <article id={`scene-${event.id}`} class={`chapter chapter-${scene.accent}`} data-chapter={index} data-mood={scene.mood} data-poetry={scene.title} aria-labelledby={`title-${event.id}`}>
          <div class="chapter-mobile-art"><img src={asset(`images/garden/${scene.image}.webp`)} alt={`${scene.mood}: an imagined ceremonial garden`} loading="lazy" width="1536" height="1024" /></div>
          <div class="chapter-copy" data-reveal>
            <div class="chapter-overline"><span>Chapter {event.number}</span><span aria-hidden="true">{scene.symbol}</span></div>
            <p class="chapter-hindi" lang="hi">{event.hindi}</p>
            <h3 id={`title-${event.id}`}>{event.name}</h3>
            <p class="chapter-line">{scene.line}</p>
            <p class="chapter-description">{event.description}</p>
            <dl class="ceremony-facts"><div><dt>When</dt><dd>{event.day}, {event.date} 2026<br /><time datetime={event.iso}>{event.time} IST</time></dd></div><div><dt>Dress code</dt><dd>{event.attire}</dd></div></dl>
            {event.meal && <p class="chapter-meal">{event.meal}</p>}
            <a class="inline-link" href={asset(`calendar/${event.id}.ics`)} download>Keep this moment <span>↗</span><span class="sr-only"> — save {event.name} to your calendar</span></a>
          </div>
        </article>;
      })}
    </div>
  </div>
  <nav class="chapter-compass" aria-label="Jump to a ceremony">
    {w.events.map((event, index) => <a href={`#scene-${event.id}`} data-chapter-link={index}><span>{event.number}</span><span>{event.name}</span></a>)}
  </nav>
  <p class="art-note">Imagined gardens, created for our celebration. All ceremonies take place at Greater Rajwada Resort, Gaya.</p>
</section>
