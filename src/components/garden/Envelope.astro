---
import { invitation as w, asset } from '../../data/invitation';
---
<section class="letter-section section-space" id="invitation" aria-labelledby="letter-title">
  <div class="letter-heading"><p class="overline">AN INVITATION FROM OUR FAMILIES</p><h2 id="letter-title">With love,<br /><em>we invite you.</em></h2></div>
  <details class="envelope" id="wedding-envelope">
    <summary><span class="envelope-pocket" aria-hidden="true"></span><span class="envelope-stitch" aria-hidden="true"></span><span class="envelope-flap" aria-hidden="true"></span><span class="envelope-to">For you, with love.</span><span class="wax-seal"><img src={asset('images/chapter/monogram.webp')} width="120" height="120" alt="PS wedding monogram" loading="lazy" /></span><span class="seal-prompt"><span class="when-closed">Open your invitation</span><span class="when-open">Close the letter</span><span aria-hidden="true"> ↗</span></span><span class="envelope-from">Swarnimam &amp; Plabini · 8–9 December 2026</span></summary>
    <div class="letter-reveal"><div class="letter-paper"><img class="letter-ganesha" src={asset('images/chapter/ganesha.webp')} width="110" height="110" loading="lazy" alt="Lord Ganesha, from our wedding invitation" /><p class="blessing" lang="hi">॥ श्री गणेशाय नमः ॥</p><p class="letter-parents">The Kumars &amp; The Nayaks</p><p>request the pleasure of your company<br />at the wedding of their children</p><p class="letter-names">Swarnimam <em>&amp;</em> Plabini</p><span class="letter-divider" aria-hidden="true">✧</span><p lang="hi" class="letter-hindi">पावन परिणयोत्सव की मंगल बेला पर<br />सपरिवार पधारकर वर-वधू को आशीर्वाद दें।</p><p class="letter-date">9 December 2026 · 7:30 pm</p><p>{w.venue.name}, Gaya</p><a class="text-link" href="#celebrations">Explore the celebrations ↓</a></div></div>
  </details>
</section>
