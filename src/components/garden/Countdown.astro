---
import { invitation } from '../../data/invitation';
const start = invitation.events[0].iso;
---
<section class="wedding-countdown" aria-labelledby="countdown-heading" data-countdown={start}>
  <div class="countdown-intro">
    <p class="overline">UNTIL WE CELEBRATE</p>
    <h2 id="countdown-heading">The anticipation.<br /><em>The beginning of forever.</em></h2>
  </div>
  <div class="countdown-clock" role="timer" aria-live="off" aria-label="Time until the wedding celebrations begin" hidden>
    {['Days', 'Hours', 'Minutes', 'Seconds'].map((unit) => <div class="countdown-unit"><span class="countdown-number" data-unit={unit.toLowerCase()}>00</span><span class="countdown-label">{unit}</span></div>)}
  </div>
  <p class="countdown-arrived" hidden>The celebrations have begun.</p>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-countdown]');
  if (root) {
    const target = Date.parse(root.dataset.countdown!);
    const clock = root.querySelector<HTMLElement>('.countdown-clock')!;
    const arrived = root.querySelector<HTMLElement>('.countdown-arrived')!;
    const fields = [...root.querySelectorAll<HTMLElement>('[data-unit]')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let interval: ReturnType<typeof setInterval> | undefined;
    let initialized = false;
    const update = () => {
      const seconds = Math.max(0, Math.ceil((target - Date.now()) / 1000));
      if (!seconds) {
        clock.hidden = true;
        arrived.hidden = false;
        root.querySelector('.overline')!.textContent = 'THE WAIT IS OVER';
        clearInterval(interval);
        return;
      }
      const values = [Math.floor(seconds / 86400), Math.floor(seconds / 3600) % 24, Math.floor(seconds / 60) % 60, seconds % 60];
      fields.forEach((field, i) => {
        const value = String(values[i]).padStart(2, '0');
        if (field.textContent !== value) {
          field.textContent = value;
          if (initialized && !reduced.matches && !document.hidden) {
            field.animate([{opacity: .45, transform: 'translateY(3px)'}, {opacity: 1, transform: 'translateY(0)'}], {duration: 280, easing: 'ease-out'});
          }
        }
      });
      clock.hidden = false;
      initialized = true;
    };
    if (Number.isFinite(target)) {
      update();
      if (Date.now() < target) interval = setInterval(() => { if (!document.hidden) update(); }, 1000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) update(); });
    }
  }
</script>
<style>
  .wedding-countdown { background:#102c27; color:#f0e7d3; padding:clamp(40px,6vw,84px) 7vw; display:grid; grid-template-columns:1fr 1.15fr; gap:40px; align-items:center; border-block:1px solid #c4ad7838; }
  .countdown-intro .overline { color:#c9b47e; margin:0 0 14px; }
  .countdown-intro h2 { font-family:'Cormorant Garamond',serif; font-size:clamp(28px,3.2vw,44px); font-weight:400; line-height:1.12; margin:0; }
  .countdown-intro h2 em { font-weight:400; color:#deca97; }
  .countdown-date { font-size:11px; letter-spacing:.06em; color:#d0c8b7; margin:20px 0 0; }
  .countdown-clock { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); text-align:center; }
  .countdown-clock[hidden], .countdown-arrived[hidden] { display:none; }
  .countdown-unit + .countdown-unit { border-left:1px solid #c4ad7838; }
  .countdown-number { display:block; font-family:'Cormorant Garamond',serif; font-size:clamp(42px,5.8vw,80px); line-height:1.05; font-weight:400; font-variant-numeric:lining-nums tabular-nums; }
  .countdown-label { display:block; margin-top:12px; font-size:9px; text-transform:uppercase; letter-spacing:.13em; color:#d5c49c; }
  .countdown-arrived { font-family:'Cormorant Garamond',serif; font-size:clamp(30px,4vw,48px); font-style:italic; }
  @media(max-width:700px) { .wedding-countdown { grid-template-columns:1fr; gap:30px; padding:40px 6vw; text-align:center; } .countdown-number { font-size:clamp(40px,12vw,65px); } .countdown-label { font-size:8px; letter-spacing:.08em; } }
  @media print { .wedding-countdown { display:none; } }
</style>
