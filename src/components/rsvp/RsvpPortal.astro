---
import { invitation as w } from '../../data/invitation';
---
<section id="rsvp" class="rsvp-section section-pad" aria-labelledby="rsvp-title">
  <div class="wrap rsvp-layout">
    <div class="rsvp-copy"><p class="eyebrow">Your presence is our favourite gift</p><h2 id="rsvp-title">Come for the wedding.<br /><em>Stay for the memories.</em></h2><p>We’d love to celebrate with you. Prepare a little note and share it with the family to let us know your plans.</p><span class="rsvp-signature">With love,<br />Swarnimam & Plabini</span></div>
    <div class="response-card">
      <p class="eyebrow">A note to the family</p>
      <form id="response-form" data-email={w.rsvpEmail} hidden>
        <label for="guest-name">Your name<input id="guest-name" name="name" required maxlength="100" autocomplete="name" placeholder="Your full name" /></label>
        <div class="form-row"><label for="attendance">Will you join us?<select id="attendance" name="attendance"><option value="accept">Joyfully accepts</option><option value="decline">Sending love from afar</option></select></label><label for="guests">Guests, including you<input type="number" id="guests" name="guests" min="1" max="30" value="1" required inputmode="numeric" /></label></div>
        <label for="guest-message">A message or special request <span>(optional)</span><textarea id="guest-message" name="message" rows="3" maxlength="1000" placeholder="A little love, or anything you’d like us to know…"></textarea></label>
        <button class="button button-wine" type="submit">Prepare my response <span aria-hidden="true">↗</span></button>
        <p class="response-help">Prepare your message here, then send it to the family. This form does not submit a response automatically.</p>
      </form>
      <noscript><p>Please send your name, attendance, and guest count directly to the family through your usual conversation.</p></noscript>
      <div id="response-result" hidden tabindex="-1">
        <h3>Your note is ready.</h3><p>Copy this message and send it to the family in your usual chat.</p>
        <label for="response-text" class="sr-only">Your prepared response</label><textarea id="response-text" readonly rows="7"></textarea>
        <div class="response-actions"><button type="button" id="copy-response" class="button button-wine">Copy message</button><button type="button" id="edit-response" class="text-button">Edit response</button></div>
        <p id="copy-status" role="status" aria-live="polite"></p>
      </div>
    </div>
  </div>
</section>
