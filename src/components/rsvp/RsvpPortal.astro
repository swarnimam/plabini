---
import { invitation as w } from '../../data/invitation';
---
<section id="rsvp" class="rsvp-section" aria-labelledby="rsvp-title">
  <div class="rsvp-layout"><div class="rsvp-copy"><p class="eyebrow">Your attendance</p><h2 id="rsvp-title">Let us know<br /><em>your plans.</em></h2><p>Use the form to prepare your attendance details, then copy and share the message with the family.</p><span class="rsvp-signature">With love,<br />Swarnimam & Plabini</span></div>
    <div class="response-card"><p class="eyebrow">A message to the family</p><form id="response-form" hidden>
      <label for="guest-name">Your name<input id="guest-name" name="name" required maxlength="100" autocomplete="name" placeholder="Your full name" /></label>
      <div class="form-row"><label for="attendance">Will you join us?<select id="attendance" name="attendance"><option value="accept">Attending</option><option value="decline">Unable to attend</option><option value="unsure">Yet to confirm</option></select></label><label for="guests">Guests, including you<input type="number" id="guests" name="guests" min="1" max="100" value="1" required inputmode="numeric" /></label></div>
      <fieldset id="event-options"><legend>Celebrations you plan to attend</legend>{w.events.map(e=><label class="check-label"><input type="checkbox" name="events" value={e.name} checked />{e.name}</label>)}</fieldset>
      <label for="guest-message">Your message <span>(optional)</span><textarea id="guest-message" name="message" rows="3" maxlength="1000" placeholder="Add a personal message, if you wish."></textarea></label>
      <button class="button" type="submit">Prepare my message ↗</button><p class="response-help">Copying this message does not send your response.</p>
    </form><noscript><p>Send your name, attendance, guest count and chosen celebrations to the family through your usual conversation.</p></noscript>
    <div id="response-result" hidden tabindex="-1"><h3>Your message is ready.</h3><p>Copy it into your usual conversation with the family. Nothing has been sent.</p><label for="response-text" class="sr-only">Your prepared message</label><textarea id="response-text" readonly rows="10"></textarea><div class="response-actions"><button type="button" id="copy-response" class="button">Copy message</button><button type="button" id="edit-response" class="text-button">Edit message</button></div><p id="copy-status" role="status" aria-live="polite"></p></div></div>
  </div>
</section>
