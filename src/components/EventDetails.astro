---
import { invitation, asset } from "../data/invitation";
interface Props {
  event: (typeof invitation.events)[number];
}
const { event } = Astro.props;
---

<div class="event-details">
  <p class="event-time">
    <time datetime={event.iso}
      >{event.day}, {event.date} 2026 <span>{event.time}</span>
    </time>
  </p>
  <p class="event-place">{invitation.venue.name} · Gaya</p>
  <p class="dress">
    <span>Dress code</span>{event.attire}
  </p>
  <a class="text-link" href={asset(`calendar/${event.id}.ics`)} download
    >Add to calendar <span aria-hidden="true">↗</span>
  </a>
</div>
