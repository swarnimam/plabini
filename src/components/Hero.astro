---
import { asset } from "../data/invitation";
---

<section class="opening" id="home" aria-labelledby="couple-names">
  <div class="hero-scenery" aria-hidden="true">
    <img
      src={asset("images/hero.webp")}
      width="1536"
      height="1024"
      fetchpriority="high"
      alt=""
    />
    <div class="hero-shade"></div>
  </div>
  <div class="gate-theatre" aria-hidden="true"><div class="gate-world">\n    <img class="gate-artwork gate-leaf gate-leaf--left" data-src={asset("images/moonlit-gate-left.webp")} width="1536" height="1024" alt="" />\n    <img class="gate-artwork gate-leaf gate-leaf--right" data-src={asset("images/moonlit-gate-right.webp")} width="1536" height="1024" alt="" />\n    <img class="gate-artwork gate-frame" data-src={asset("images/moonlit-gate-frame.webp")} width="1536" height="1024" alt="" />\n  </div></div>\n  <button class="gate-enter" id="gate-enter" type="button" hidden aria-label="Open our invitation"><img src={asset("images/monogram.webp")} alt="" width="96" height="96" /></button>\n  <div class="hero-copy">
    <p class="hero-preface">We’re getting married.</p>
    <h1 id="couple-names">
      <span>Swarnimam</span>
      <i>&</i>
      <span>Plabini</span>
    </h1>
    <div class="hero-date">
      <span>08 — 09</span>
      <p>DECEMBER 2026<br />GREATER RAJWADA RESORT · GAYA</p>
    </div>
    <a class="hero-enter" href="#celebrations">
      <span>Explore the celebrations</span>
      <b aria-hidden="true">↓</b>
    </a>
  </div>
</section>
