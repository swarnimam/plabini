---
import { asset } from "../data/invitation";
---

<section class="opening" id="home" aria-labelledby="couple-names">
  <div class="hero-scenery" aria-hidden="true">
    <img
      src={asset("images/hero.webp")}
      width="1536"
      height="1024"
      fetchpriority="high"
      alt=""
    />
    <div class="hero-shade"></div>
  </div>
  <div class="palace-door door-left" aria-hidden="true"><svg class="gate-art" viewBox="0 0 440 900" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="wood" x1="0" x2="1"><stop stop-color="#071c19"/><stop offset=".25" stop-color="#24473a"/><stop offset=".7" stop-color="#12372f"/><stop offset="1" stop-color="#071c19"/></linearGradient><pattern id="engrave" width="48" height="48" patternUnits="userSpaceOnUse"><path d="M24 3C38 13 38 35 24 45C10 35 10 13 24 3ZM3 24H45M24 3V45" fill="none" stroke="#b69b5d" stroke-opacity=".25" stroke-width="1"/></pattern></defs><rect width="440" height="900" fill="url(#wood)"/><rect x="14" y="14" width="412" height="872" rx="6" fill="none" stroke="#d2ad69" stroke-width="4"/><rect x="29" y="29" width="382" height="842" rx="3" fill="none" stroke="#896b3e" stroke-width="2"/><path d="M68 826V242Q68 101 220 57Q372 101 372 242V826Z" fill="url(#engrave)" stroke="#d2b274" stroke-width="5"/><path d="M86 806V245Q86 130 220 83Q354 130 354 245V806Z" fill="none" stroke="#947341" stroke-width="2"/><path d="M220 112V798M94 315H346M94 632H346" stroke="#d0a960" stroke-opacity=".4" stroke-width="2"/><g fill="none" stroke="#d9b879" stroke-width="2"><circle cx="220" cy="305" r="83"/><circle cx="220" cy="305" r="66"/><path d="M220 228Q275 305 220 382Q165 305 220 228ZM143 305Q220 250 297 305Q220 360 143 305Z"/><circle cx="220" cy="305" r="15"/><path d="M220 187V213M220 397V423M102 305H128M312 305H338"/></g><g fill="none" stroke="#b99a5e" stroke-width="2"><path d="M130 550Q220 465 310 550Q220 635 130 550Z"/><path d="M220 470V625M145 550H295"/><circle cx="220" cy="550" r="35"/><path d="M220 515L255 550L220 585L185 550Z"/></g><path d="M70 842H370" stroke="#e0bd76" stroke-width="4"/></svg></div>
  <div class="palace-door door-right" aria-hidden="true"><svg class="gate-art" viewBox="0 0 440 900" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="wood" x1="0" x2="1"><stop stop-color="#071c19"/><stop offset=".25" stop-color="#24473a"/><stop offset=".7" stop-color="#12372f"/><stop offset="1" stop-color="#071c19"/></linearGradient><pattern id="engrave" width="48" height="48" patternUnits="userSpaceOnUse"><path d="M24 3C38 13 38 35 24 45C10 35 10 13 24 3ZM3 24H45M24 3V45" fill="none" stroke="#b69b5d" stroke-opacity=".25" stroke-width="1"/></pattern></defs><rect width="440" height="900" fill="url(#wood)"/><rect x="14" y="14" width="412" height="872" rx="6" fill="none" stroke="#d2ad69" stroke-width="4"/><rect x="29" y="29" width="382" height="842" rx="3" fill="none" stroke="#896b3e" stroke-width="2"/><path d="M68 826V242Q68 101 220 57Q372 101 372 242V826Z" fill="url(#engrave)" stroke="#d2b274" stroke-width="5"/><path d="M86 806V245Q86 130 220 83Q354 130 354 245V806Z" fill="none" stroke="#947341" stroke-width="2"/><path d="M220 112V798M94 315H346M94 632H346" stroke="#d0a960" stroke-opacity=".4" stroke-width="2"/><g fill="none" stroke="#d9b879" stroke-width="2"><circle cx="220" cy="305" r="83"/><circle cx="220" cy="305" r="66"/><path d="M220 228Q275 305 220 382Q165 305 220 228ZM143 305Q220 250 297 305Q220 360 143 305Z"/><circle cx="220" cy="305" r="15"/><path d="M220 187V213M220 397V423M102 305H128M312 305H338"/></g><g fill="none" stroke="#b99a5e" stroke-width="2"><path d="M130 550Q220 465 310 550Q220 635 130 550Z"/><path d="M220 470V625M145 550H295"/><circle cx="220" cy="550" r="35"/><path d="M220 515L255 550L220 585L185 550Z"/></g><path d="M70 842H370" stroke="#e0bd76" stroke-width="4"/></svg></div>
  <div class="gate-glow" aria-hidden="true"></div><div class="gate-sparks" aria-hidden="true">{Array.from({length: 16}, (_, i) => <i style={`--n:${i};--x:${(i*37)%100}%;--y:${(i*53)%100}%`}></i>)}</div>
  <button class="gate-enter" id="gate-enter" type="button" hidden aria-label="Open the wedding gates and enter the invitation"><span class="gate-medallion" aria-hidden="true"><span>श्री</span></span><span class="gate-action">Enter our celebration</span><small>Touch the seal to begin</small></button>
  <div class="hero-copy">
    <p class="hero-preface">We’re getting married.</p>
    <h1 id="couple-names">
      <span>Swarnimam</span>
      <i>&</i>
      <span>Plabini</span>
    </h1>
    <div class="hero-date">
      <span>08 — 09</span>
      <p>DECEMBER 2026<br />GREATER RAJWADA RESORT · GAYA</p>
    </div>
    <a class="hero-enter" href="#celebrations">
      <span>Explore the celebrations</span>
      <b aria-hidden="true">↓</b>
    </a>
  </div>
</section>
