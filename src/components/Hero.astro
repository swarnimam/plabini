---
import { asset } from "../data/invitation";
---

<!-- Set the entrance state before the hero paints; without JS, the invitation is visible. -->
<script is:inline>
  document.documentElement.dataset.gates = "loading";
</script>

<section class="opening" id="home" aria-labelledby="couple-names">
  <div class="hero-scenery" aria-hidden="true">
    <img
      src={asset("images/hero.webp")}
      width="1536"
      height="1024"
      fetchpriority="high"
      alt=""
    />
    <div class="hero-shade"></div>
  </div>

  <div class="gate-theatre" aria-hidden="true">
    <div class="gate-world">
      <img
        class="gate-artwork gate-leaf gate-leaf--left"
        src={asset("images/moonlit-gate-left.webp")}
        width="1536"
        height="1024"
        alt=""
        decoding="async"
      />
      <img
        class="gate-artwork gate-leaf gate-leaf--right"
        src={asset("images/moonlit-gate-right.webp")}
        width="1536"
        height="1024"
        alt=""
        decoding="async"
      />
      <img
        class="gate-artwork gate-frame"
        src={asset("images/moonlit-gate-frame.webp")}
        width="1536"
        height="1024"
        alt=""
        decoding="async"
      />
    </div>
  </div>
  <!-- The PS emblem is already part of the artwork. Keep the actual hit target invisible. -->
  <button
    class="gate-enter"
    id="gate-enter"
    type="button"
    hidden
    aria-label="Open Swarnimam and Plabini's wedding invitation"
  ></button>

  <div class="hero-copy">
    <div class="hero-copy-inner">
    <p class="hero-preface">We’re getting married.</p>
    <h1 id="couple-names">
      <span>Swarnimam</span>
      <i>&</i>
      <span>Plabini</span>
    </h1>
    <div class="hero-date">
      <span>08 — 09</span>
      <p>DECEMBER 2026<br />GREATER RAJWADA RESORT · GAYA</p>
    </div>
    <a class="hero-enter" href="#celebrations">
      <span>Explore the celebrations</span>
      <b aria-hidden="true">↓</b>
    </a>
    </div>
  </div>
</section>
