---
import { asset } from "../data/invitation";
---

<section class="opening" id="home" aria-labelledby="couple-names">
  <div class="hero-scenery" aria-hidden="true">
    <img
      src={asset("images/hero.webp")}
      width="1536"
      height="1024"
      fetchpriority="high"
      alt=""
    />
    <div class="hero-shade"></div>
  </div>
  <div class="palace-door door-left" aria-hidden="true"></div>
  <div class="palace-door door-right" aria-hidden="true"></div>
  <div class="hero-copy">
    <p class="hero-preface">We’re getting married.</p>
    <h1 id="couple-names">
      <span>Swarnimam</span>
      <i>&</i>
      <span>Plabini</span>
    </h1>
    <div class="hero-date">
      <span>08 — 09</span>
      <p>DECEMBER 2026<br />GREATER RAJWADA RESORT · GAYA</p>
    </div>
    <a class="hero-enter" href="#celebrations">
      <span>Explore the celebrations</span>
      <b aria-hidden="true">↓</b>
    </a>
  </div>
</section>
