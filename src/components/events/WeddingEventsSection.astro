---
import { invitation as w, asset } from '../../data/invitation';
---
<section id="celebrations" class="events-section section-pad" aria-labelledby="events-title">
  <div class="wrap">
    <div class="section-heading reveal"><p class="eyebrow" lang="hi">मांगलिक कार्यक्रम</p><h2 id="events-title">Two days. <em>A lifetime of memories.</em></h2><p>A little tradition, a little dancing, and a whole lot of love.</p></div>
    <div class="schedule-toolbar"><span>8 & 9 December 2026 <span aria-hidden="true">·</span> All times in IST</span><a href={asset('celebrations.ics')} download>Save the dates <span aria-hidden="true">↗</span></a></div>
    <ol class="event-timeline">
      {w.events.map((event) => <li class={`event-row ${event.theme}`}>
        <div class="timeline-node" aria-hidden="true">{event.number}</div>
        <article class="event-card reveal" aria-labelledby={`${event.id}-title`}>
          <div class="event-card-top"><span class="eyebrow">{event.day} · {event.date}</span><span class="event-motif" aria-hidden="true">{event.motif === 'music' ? '♫' : event.motif === 'sun' ? '☼' : event.motif === 'rings' ? '∞' : '✻'}</span></div>
          <p class="event-hindi" lang="hi">{event.hindi}</p><h3 id={`${event.id}-title`}>{event.name}</h3>
          <p class="event-time"><time datetime={event.iso}>{event.time}</time></p>
          <p class="event-description">{event.description}</p>
          {event.attire && <p class="event-attire"><strong>Dress note</strong>{event.attire}</p>}
          {event.meal && <p class="event-meal">{event.meal}</p>}
          <div class="event-card-bottom"><span>{w.venue.name}, Gaya</span><a href={asset(`calendar/${event.id}.ics`)} download aria-label={`Add ${event.name} to your calendar`}>Add to calendar <span aria-hidden="true">↗</span></a></div>
        </article>
        <div class="event-side-note" aria-hidden="true"><span>{event.number}</span><i>{['The beginning', 'An evening to remember', 'A little golden magic', 'Our forever begins'][Number(event.number) - 1]}</i></div>
      </li>)}
    </ol>
    <p class="schedule-closing">Four celebrations. One beautiful beginning. <span aria-hidden="true">✧</span></p>
  </div>
</section>
