---
import { invitation as w } from "../data/invitation";
---

<section id="venue" class="venue section-space" aria-labelledby="venue-title">
  <div class="venue-copy">
    <p class="overline">THE WEDDING VENUE</p>
    <h2 id="venue-title">
      We look forward to<br />
      <em>welcoming you<br />in Gaya.</em>
    </h2>
    <p class="venue-name">Greater Rajwada Resort</p>
    <p>Manpur, Gaya · Near Mehta Petrol Pump<br />Bihar, India</p>
    <a
      class="button"
      href={w.venue.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      >Open directions ↗<span class="sr-only"> in Google Maps, new tab</span>
    </a>
  </div>
  <div class="venue-art" aria-hidden="true">
    <span>08</span>
    <i>&</i>
    <span>09</span>
    <p>DECEMBER<br />GAYA, BIHAR</p>
    <svg viewBox="0 0 400 500" fill="none">
      <path d="M-40 40C460 0 450 500 80 440S-100 200 440 200"></path>
      <path d="M-40 60C430 20 430 480 100 420S-70 220 440 220"></path>
    </svg>
  </div>
</section>
