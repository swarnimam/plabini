---
import { invitation as w, asset } from "../data/invitation";
---

<section
  class="letter-section section-space"
  id="invitation"
  aria-labelledby="letter-title"
>
  <div class="letter-heading">
    <p class="overline">A letter from our hearts</p>
    <h2 id="letter-title">
      Some things are better<br />
      <em>opened with love.</em>
    </h2>
  </div>
  <details class="envelope" id="wedding-envelope">
    <summary>
      <span class="envelope-pocket" aria-hidden="true"> </span>
      <span class="envelope-stitch" aria-hidden="true"> </span>
      <span class="envelope-flap" aria-hidden="true"> </span>
      <span class="envelope-to">To our favourite people</span>
      <span class="wax-seal">
        <img
          src={asset("images/monogram.webp")}
          width="120"
          height="120"
          alt="PS wedding monogram"
          loading="lazy"
        />
      </span>
      <span class="seal-prompt">
        <span class="when-closed">Open your invitation</span>
        <span class="when-open">Close the letter</span>
        <span aria-hidden="true"> ↗</span>
      </span>
    </summary>
    <div class="letter-reveal">
      <div class="letter-paper">
        <img
          class="letter-ganesha"
          src={asset("images/ganesha.webp")}
          width="110"
          height="110"
          loading="lazy"
          alt="Lord Ganesha, from our wedding invitation"
        />
        <p class="blessing" lang="hi">॥ श्री गणेशाय नमः ॥</p>
        <p class="letter-parents">THE KUMAR FAMILY &amp; THE NAYAK FAMILY</p>
        <p class="letter-intro">With immense joy and heartfelt warmth, cordially invite you to celebrate the union of their beloved children</p>
        <p class="letter-names">SWARNIMAM <em>&amp;</em> PLABINI</p>
        <span class="letter-divider" aria-hidden="true">✧</span>
        <p class="letter-sentiment">Two hearts, two families, one beautiful beginning.</p>
        <p class="letter-message">As they turn the page to a new chapter, we look forward to celebrating this auspicious occasion together, surrounded by cherished traditions and happy moments.</p>
        <p lang="hi" class="letter-hindi">पावन परिणयोत्सव की मंगल बेला पर<br />सपरिवार पधारकर वर-वधू को आशीर्वाद दें।</p>
        <p class="letter-date">9 December 2026 · 7:30 PM</p>
        <p>{w.venue.name}, Gaya</p>
        <p class="letter-signoff">With affection and best wishes,<br /><span>The Kumar &amp; Nayak Families</span></p>
        <a class="text-link" href="#celebrations">Explore the celebrations ↓</a>
      </div>
    </div>
  </details>
</section>
