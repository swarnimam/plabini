---
import { invitation, asset } from '../data/invitation';
import '../styles/chapter.css';
import '../styles/celebration.css';
const title = `${invitation.names.groom} & ${invitation.names.bride} | 8–9 December 2026`;
const description = `Together with our families, we invite you to celebrate our wedding on 8–9 December 2026 at ${invitation.venue.name}, Gaya. #perfectlyPS`;
const canonical = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site) : undefined;
const structuredData = {
  '@context': 'https://schema.org', '@type': 'Event', name: 'Swarnimam & Plabini — Wedding Celebrations',
  startDate: invitation.events[0].iso, endDate: '2026-12-09',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode', eventStatus: 'https://schema.org/EventScheduled',
  description, location: { '@type': 'Place', name: invitation.venue.name, address: {
    '@type': 'PostalAddress', streetAddress: 'Manpur, near Mehta Petrol Pump', addressLocality: 'Gaya', addressRegion: 'Bihar', addressCountry: 'IN',
  } },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#360d26" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={Astro.site ? new URL(asset('images/ps-monogram.jpg'), Astro.site).href : asset('images/ps-monogram.jpg')} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600&family=Noto+Serif+Devanagari:wght@400;500&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to invitation</a>
    <slot />
  </body>
</html>
