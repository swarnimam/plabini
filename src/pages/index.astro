---
import BaseLayout from '../layouts/BaseLayout.astro';
import { invitation as w, asset } from '../data/invitation';
import Envelope from '../components/garden/Envelope.astro';
import ChapterJourney from '../components/garden/ChapterJourney.astro';
import Ritual from '../components/garden/Ritual.astro';
import Plan from '../components/garden/Plan.astro';
import RsvpPortal from '../components/rsvp/RsvpPortal.astro';
---
<BaseLayout>
  <div class="reading-progress" aria-hidden="true"><span id="reading-progress"></span></div>
  <header class="garden-header">
    <a href="#home" class="garden-brand" aria-label="Swarnimam and Plabini, home"><span>P<span class="brand-amp">&</span>S</span><small>#perfectlyPS</small></a>
    <nav class="garden-nav" aria-label="Main navigation"><a href="#invitation">The invitation</a><a href="#celebrations">The celebrations</a><a href="#venue">The destination</a></nav>
    <div class="header-end"><a class="details-fallback" href="#schedule">The details ↗</a><button type="button" data-open-plan hidden>The details <span aria-hidden="true">↗</span></button><details class="garden-menu"><summary aria-label="Open navigation"><span></span><span></span></summary><nav aria-label="Mobile navigation"><a href="#invitation">The invitation</a><a href="#celebrations">The celebrations</a><a href="#venue">The destination</a><a href="#rsvp">Your response</a></nav></details></div>
  </header>
  <main id="main">
    <section id="home" class="garden-hero" aria-labelledby="couple-names">
      <div class="hero-art" id="hero-art"><img src={asset('images/garden/forever-night.webp')} width="1536" height="1024" alt="An imagined moonlit garden with a golden mandap, lotus pool and peacock" fetchpriority="high" /></div>
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="fireflies" aria-hidden="true">{Array.from({length:14},(_,i)=><span style={`--i:${i};--x:${(i*37+11)%100}%;--y:${(i*23+19)%80}%`}></span>)}</div>
      <div class="hero-side-note" aria-hidden="true">A CELEBRATION WRITTEN IN THE STARS</div>
      <div class="garden-hero-copy">
        <p class="hero-kicker">THE GARDEN OF FOREVER</p>
        <p class="hero-blessing" lang="hi">॥ श्री गणेशाय नमः ॥</p>
        <h1 id="couple-names"><span class="hero-first">Swarnimam</span><em>&</em><span class="hero-second">Plabini</span></h1>
        <p class="hero-poem">Two hearts. One beautiful universe.</p>
        <a class="enter-garden" href="#invitation"><span class="enter-circle" aria-hidden="true">↓</span><span>Let our forever unfold</span></a>
      </div>
      <div class="hero-bottom-line"><p>08—09 <span>DECEMBER 2026</span></p><span class="hero-location">GREATER RAJWADA RESORT · GAYA</span><a href="#celebrations">Explore the four worlds <span aria-hidden="true">↗</span></a></div>
    </section>
    <section class="overture" aria-label="An invitation to celebrate"><span class="overture-symbol" aria-hidden="true">✧</span><p>Come for the promises.<br />Stay for the <em>magic.</em></p><span class="overture-note">Our wedding. Your presence.<br />Everything we could wish for.</span></section>
    <Envelope />
    <div class="garden-interlude" aria-hidden="true"><span>Two days</span><i>✧</i><span>Four celebrations</span><i>✧</i><span>One forever</span></div>
    <ChapterJourney />
    <Ritual />
    <section class="forever-countdown" aria-labelledby="countdown-title">
      <div class="countdown-heading"><p class="eyebrow">The next chapter is almost here</p><h2 id="countdown-title">A lifetime awaits.</h2></div>
      <div class="countdown" data-wedding-date={w.weddingISO} role="timer" aria-label="Time remaining until the wedding celebration">{['Days','Hours','Minutes','Seconds'].map((unit)=><div><span data-unit={unit.toLowerCase()}>—</span><small>{unit}</small></div>)}</div>
      <p>9 December 2026 · 7:30 pm IST</p>
    </section>
    <section id="venue" class="destination" aria-labelledby="venue-title">
      <div class="destination-top"><p class="eyebrow">04 / Where our worlds come together</p><span>BIHAR, INDIA · 08—09 DECEMBER</span></div>
      <div class="destination-grid"><div class="destination-heading" data-reveal><p class="destination-city">Gaya<span aria-hidden="true">.</span></p><h2 id="venue-title">One place.<br />All our <em>favourite people.</em></h2><p>From the first blessing to the last dance,<br />this is where we’ll make our memories.</p></div>
        <div class="destination-ticket" data-reveal><div class="ticket-top"><span>A JOURNEY TO REMEMBER</span><span aria-hidden="true">✧</span></div><h3>Greater<br /><em>Rajwada Resort</em></h3><p>Manpur, Gaya, Bihar<br />Near Mehta Petrol Pump</p><div class="ticket-perforation" aria-hidden="true"></div><dl><div><dt>Dates</dt><dd>8–9 December 2026</dd></div><div><dt>Occasion</dt><dd>Our forever begins</dd></div></dl><a class="button button-ink" href={w.venue.mapsUrl} target="_blank" rel="noopener noreferrer">Find your way to us <span aria-hidden="true">↗</span><span class="sr-only"> (opens Google Maps in a new tab)</span></a><p class="ticket-note">For arrival arrangements, get in touch with the family.</p></div>
      </div>
    </section>
    <section class="schedule-section" id="schedule" aria-labelledby="schedule-title"><div class="schedule-heading"><p class="eyebrow">The beautiful, practical details</p><h2 id="schedule-title">Your place<br />in the <em>celebration.</em></h2><p>All four moments, at a glance.<br />Save the dates. Pick your colours.<br />We’ll take care of the memories.</p></div><Plan /></section>
    <RsvpPortal />
  </main>
  <footer class="garden-footer"><p class="eyebrow">Every story needs its favourite people.</p><p class="footer-large">See you in<br /><em>our forever.</em><span aria-hidden="true">✧</span></p><div class="footer-signature"><p>Swarnimam <em>&</em> Plabini</p><span>#perfectlyPS</span></div><div class="footer-bottom"><span>8–9 December 2026 · Gaya</span><span>With love, the entire Kumar family</span><a href="#home">Back to the stars ↑</a></div></footer>
  <div class="experience-controls" hidden><button type="button" id="sound-toggle" aria-pressed="false"><span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span id="sound-label">Sound off</span></button><span class="control-divider" aria-hidden="true"></span><button type="button" id="motion-toggle" aria-pressed="true">Motion on</button></div>
  <span id="experience-status" class="sr-only" role="status"></span>
  <dialog id="plan-dialog" aria-labelledby="plan-dialog-title"><form method="dialog"><button class="dialog-close" aria-label="Close celebration details">×</button></form><p class="eyebrow">An invitation to our forever</p><h2 id="plan-dialog-title">The <em>celebrations.</em></h2><Plan compact /></dialog>
  <script src="../scripts/invitation.ts"></script>
  <script src="../scripts/garden.ts"></script>
</BaseLayout>
