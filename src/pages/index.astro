---
import BaseLayout from "../layouts/BaseLayout.astro";
import { invitation, asset } from "../data/invitation";
import Hero from "../components/Hero.astro";
import Story from "../components/Story.astro";
import Celebrations from "../components/Celebrations.astro";
import Venue from "../components/Venue.astro";
import Footer from "../components/Footer.astro";
import Envelope from "../components/Envelope.astro";
import RsvpForm from "../components/RsvpForm.astro";
import Countdown from "../components/Countdown.astro";
---

<BaseLayout>
  <header class="site-header">
    <a class="brand" href="#home" aria-label="Swarnimam and Plabini, home"
      ><img
        src={asset("images/monogram.webp")}
        width="64"
        height="64"
        alt="PS wedding monogram"
      /><small>{invitation.hashtag}</small></a
    >
    <nav aria-label="Main navigation">
      <a href="#story">Our story</a><a href="#celebrations">Celebrations</a><a
        href="#venue">Venue</a>
    </nav>
  </header>
  <main id="main">
    <Hero />
    <Countdown />
    <Story />
    <Envelope />
    <Celebrations />
    <Venue />
    <RsvpForm />
  </main>
  <Footer />
  <script src="../scripts/animations.ts"></script>
  <script src="../scripts/rsvp.ts"></script>
</BaseLayout>
