---
import {asset} from '../data/invitation';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex"/><title>Responsive preview</title></head><body style="margin:0;background:#222;color:#fff;font:14px sans-serif"><div style="padding:12px;display:flex;gap:20px;align-items:center"><label>Viewport <select id="size"><option value="390">390 × 844</option><option value="360">360 × 800</option><option value="768">768 × 1024</option></select></label><a href={asset('')} style="color:white">Full window ↗</a></div><iframe title="Wedding mobile preview" src={asset('')} style="display:block;width:390px;height:844px;border:0;margin:auto;max-width:100%"></iframe><script>const select=document.querySelector('select')!;select.addEventListener('change',()=>{const frame=document.querySelector('iframe')!;frame.style.width=select.value+'px';frame.style.height=(select.value==='360'?800:select.value==='768'?1024:844)+'px';});</script></body></html>
